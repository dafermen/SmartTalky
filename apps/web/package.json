{
  "name": "@smarttalky/web",
  "version": "0.0.0",
  "private": true,
  "description": "Aplicación web de SmartTalky.",
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../.. run build:dependencies && npm --prefix ../.. run docs:publish",
    "dev": "vite",
    "prebuild": "npm --prefix ../.. run build:dependencies && npm --prefix ../.. run docs:publish",
    "build": "tsc -b && vite build",
    "pretypecheck": "npm --prefix ../.. run build:dependencies",
    "typecheck": "tsc -b --pretty false",
    "pretest": "npm --prefix ../.. run build:dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.2",
    "@hookform/resolvers": "5.4.0",
    "@smarttalky/shared": "0.0.0",
    "@smarttalky/ui": "0.0.0",
    "@tanstack/react-query": "5.101.2",
    "i18next": "26.3.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.82.0",
    "react-i18next": "17.0.10",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.3",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@smarttalky/config": "0.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "axe-core": "4.12.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.1.5"
  }
}
