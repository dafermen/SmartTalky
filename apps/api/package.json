{
  "name": "@smarttalky/api",
  "version": "0.0.0",
  "private": true,
  "description": "API de SmartTalky.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@smarttalky/shared": "0.0.0",
    "@smarttalky/types": "0.0.0",
    "express": "5.2.1",
    "openai": "^6.48.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@smarttalky/config": "0.0.0",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
