# Entorno de ejecución de la API: development, test o production.
NODE_ENV=development

# Puerto TCP local de la API.
HOST=127.0.0.1
PORT=3000

# Destino del proxy de desarrollo web; ajústelo si el puerto 3000 está ocupado.
SMARTTALKY_API_TARGET=http://127.0.0.1:3000

# Orígenes web autorizados, separados por coma. Capacitor Android usa este origen local.
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost

# Nivel de logs: fatal, error, warn, info, debug, trace o silent.
LOG_LEVEL=info

# Opcional hasta la Fase 4. Nunca escriba una clave real en este archivo versionado.
OPENAI_API_KEY=

# Debe cambiarse explícitamente a true para permitir una única prueba TTS pagada.
SMARTTALKY_RUN_PAID_TTS=false

# Políticas backend; reduzca solo después de medir y probar.
TTS_TIMEOUT_MS=30000
TTS_MAX_RETRIES=1
OPENAI_EDUCATIONAL_MODEL=gpt-5.6
EDUCATIONAL_TIMEOUT_MS=20000
AUDIO_CACHE_MAXIMUM_BYTES=536870912
EDUCATIONAL_CACHE_MAXIMUM_ENTRIES=10000
PROVIDER_GENERATION_BUDGET_MAXIMUM=120
PROVIDER_GENERATION_BUDGET_WINDOW_MS=3600000
PRONUNCIATION_RATE_LIMIT_MAX=30
PRONUNCIATION_RATE_LIMIT_WINDOW_MS=60000

# Número de proxies controlados frente a Express. Local: 0; Docker+Nginx: 2.
TRUST_PROXY_HOPS=0

# Centro temporal para evaluadores. Use false antes de la distribución pública final.
VITE_SHOW_DOCUMENTATION=true
